# Zenith Early Boot Protection
# Triggers guardian before module initialization to catch early crashes
# Created by @szucsy92 & @A1X31

on post-fs-data
    # Use exec to ensure it finishes writing the counter (and reading pstore) before proceeding
    exec u:r:su:s0 root root -- /system/bin/sh /system/bin/config_launcher.sh boot_guardian
    # Now start the standard KSU module preparation
    start ksu_init_sh

service ksu_init_sh /system/bin/sh /system/bin/ksu_init.sh
    user root
    group root
    seclabel u:r:su:s0
    oneshot
